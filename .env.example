# Optional. Keep this token on the server; never use a NEXT_PUBLIC_ prefix.
GITHUB_USERNAME=
GITHUB_TOKEN=
SITE_URL=http://localhost:3000

# Direct inquiry delivery. Server-only Google App Password, never a normal password.
# Enable 2-Step Verification, then https://myaccount.google.com/apppasswords
# GMAIL_USER defaults to profile.email. Restart the server after configuring.
GMAIL_USER=welpanogaling12@gmail.com
GMAIL_APP_PASSWORD=

# AI portfolio assistant. Server-only; never use NEXT_PUBLIC_ for this key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Two-way Telegram messaging. All values stay on the server.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
CHAT_DATA_DIR=.data/chat
CHAT_REDIS_PREFIX=portfolio:chat

# Shared visitor counter for Vercel/serverless hosting. Keep both server-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
VISITOR_REDIS_KEY=welquim:portfolio:visits
# Optional persistent directory for local/single-server hosting (default .data).
VISITOR_DATA_DIR=

